# ── Application ──────────────────────────────────────────────────
# Ganti dengan 'production' saat deploy ke STB / server
APP_ENV=production
APP_PORT=8080
TIMEZONE=Asia/Jakarta

# ── Database (MySQL) ──────────────────────────────────────────────
# Gunakan 'mysql' jika deploy menggunakan Docker Compose (sesuai nama service compose.yaml)
# Gunakan '127.0.0.1' atau IP STB jika MySQL dijalankan langsung di host (tanpa Docker)
DB_HOST=mysql
DB_PORT=3306
DB_USER=my_assistant_gw
DB_PASSWORD=change_this_to_a_strong_database_password
DB_NAME=my_assistant_gw
# MYSQL_ROOT_PASSWORD digunakan oleh container MySQL di compose.yaml
MYSQL_ROOT_PASSWORD=change_this_to_a_different_strong_password

# ── LLM Configuration ────────────────────────────────────────────
# Pilihan provider: "gemini" atau "openrouter" (default: gemini)
LLM_PROVIDER=gemini

# ── Google Gemini (Default Provider) ──────────────────────────────
# Dapatkan API key gratis di: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── OpenRouter (Alternatif Provider) ──────────────────────────────
# Dapatkan API key di: https://openrouter.ai
# Aktif jika LLM_PROVIDER=openrouter atau jika GEMINI_API_KEY kosong
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model rekomendasi: openai/gpt-4o-mini, google/gemini-2.5-flash, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Web Search (Tavily) ──────────────────────────────────────────
# Dapatkan API key gratis (1000 searches/bulan) di: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── WhatsApp ─────────────────────────────────────────────────────
# Nomor WhatsApp pemilik bot dalam format JID internasional (tanpa tanda +)
# Format: <kode_negara><nomor>@s.whatsapp.net
# Contoh: 6281234567890@s.whatsapp.net
WA_PHONE_NUMBER=628xxxxxxxxxxxx@s.whatsapp.net

# ── Redis (Opsional / Background Worker Asynq) ───────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────
# Kunci rahasia acak untuk keperluan autentikasi JWT / sesi
JWT_SECRET=change_this_to_a_strong_random_secret

