# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
TIMEZONE=Asia/Jakarta

# ── Database (MySQL) ──────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=my_assistant_gw
DB_PASSWORD=change_this_to_a_strong_database_password
DB_NAME=my_assistant_gw
MYSQL_ROOT_PASSWORD=change_this_to_a_different_strong_password

# ── LLM (OpenRouter) ─────────────────────────────────────────────
# Get your API key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended free/cheap models:
#   openai/gpt-4o-mini       — fast, cheap, great for structured tasks
#   google/gemini-flash-1.5  — fast, free tier available
#   meta-llama/llama-3.1-8b-instruct:free — fully free
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Redis (for asynq — optional in V1, used for scheduled jobs) ───
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── WhatsApp ─────────────────────────────────────────────────────
# Your WhatsApp number in international format (without +)
# Format: <countrycode><number>@s.whatsapp.net
# Example: 6281234567890@s.whatsapp.net
WA_PHONE_NUMBER=628xxxxxxxxxxxx@s.whatsapp.net

# ── Security ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret
